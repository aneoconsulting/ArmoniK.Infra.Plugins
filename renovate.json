{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchPackagePrefixes": [
        "ArmoniK"
      ],
      "groupName": "release packages Armonik"
    },
    {
      "matchPackageNames": [
        "!ArmoniK{/,}**"
      ],
      "groupName": "other dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Cargo tools installed in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
